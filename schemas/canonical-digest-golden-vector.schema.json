{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instruction-governance.local/schemas/canonical-digest-golden-vector.schema.json",
  "title": "Canonical Digest Golden Vector",
  "description": "Language-neutral conformance corpus row for gwc-jcs-v1 cross-runtime verification. Positive vectors carry expected canonical bytes + framed SHA-256; negative vectors carry expected deterministic taxonomy error. Raw lexical input is preserved (as a string) so duplicate-key and negative-zero evidence is never collapsed by a parser.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vector_id",
    "category",
    "input",
    "input_is_raw_text",
    "profile_id"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "vector_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
    "category": {"type": "string", "enum": ["POSITIVE", "NEGATIVE"]},
    "input": {"type": "string", "minLength": 1},
    "input_is_raw_text": {"type": "boolean"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "domain": {"type": "string"},
    "schema_ref": {"type": "string"},
    "preimage_framing_scheme": {"type": "string", "const": "gwc-domain-sep-v1"},
    "expected_canonical_bytes_hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "expected_sha256_framed": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_error": {
      "type": "string",
      "enum": [
        "DIGEST_INPUT_DOMAIN_VIOLATION",
        "DIGEST_NEGATIVE_ZERO_REJECTED",
        "DIGEST_NON_FINITE_REJECTED",
        "DIGEST_NON_STRING_KEY_REJECTED",
        "DIGEST_DUPLICATE_RAW_KEY_REJECTED",
        "DIGEST_INVALID_UNICODE_REJECTED",
        "DIGEST_RESOURCE_LIMIT_EXCEEDED"
      ]
    },
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"category": {"const": "POSITIVE"}}},
      "then": {
        "required": ["expected_canonical_bytes_hex", "expected_sha256_framed"],
        "properties": {
          "expected_error": false
        }
      }
    },
    {
      "if": {"properties": {"category": {"const": "NEGATIVE"}}},
      "then": {
        "required": ["expected_error"],
        "properties": {
          "expected_canonical_bytes_hex": false,
          "expected_sha256_framed": false
        }
      }
    }
  ]
}
