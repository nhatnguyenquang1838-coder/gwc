{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gwc.dev/schemas/node-architect/package-export/smoke-verification.schema.json",
  "title": "Package Export Smoke Verification result",
  "description": "Closed, versioned runtime contract for the offline smoke-verification evidence generator (SCRUM-236, M5_REPLAY_SAFE). The typed result is the only PASS signal; it never grants repository, PR, merge, deploy or release authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "task_id",
    "package_identity",
    "idempotency_key",
    "verifier_version",
    "environment_digest",
    "result_digest",
    "outcome",
    "reason",
    "authority_granted"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "gwc.package_export.smoke_verification"
    },
    "schema_version": {
      "type": "string",
      "enum": ["0.1"]
    },
    "task_id": {
      "type": "string",
      "description": "Governed task identity that produced this verification."
    },
    "package_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha", "manifest_digest", "output_tree_digest"],
      "properties": {
        "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "output_tree_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "project_id": { "type": "string" },
        "package_version": { "type": "string" },
        "source_ref": { "type": "string" }
      }
    },
    "idempotency_key": {
      "type": "string",
      "description": "Smoke idempotency key; identical package identity + key => identical result."
    },
    "verifier_version": { "type": "string" },
    "environment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Digest of the observed offline environment (verifier, python, os, network state, clean-directory verdict)."
    },
    "result_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Canonical deterministic digest of the verification result, excluding observational fields."
    },
    "outcome": {
      "type": "string",
      "enum": ["PASS", "FAIL"]
    },
    "reason": {
      "type": "string",
      "enum": [
        "SMOKE_VERIFICATION_PASS",
        "SMOKE_MANIFEST_INVALID",
        "SMOKE_REQUIRED_TARGET_MISSING",
        "SMOKE_HASH_MISMATCH",
        "SMOKE_EXTRACTION_FAILED",
        "SMOKE_LOAD_FAILED",
        "SMOKE_TIMEOUT",
        "SMOKE_ENVIRONMENT_UNSAFE",
        "SMOKE_RESULT_UNKNOWN",
        "SMOKE_IDEMPOTENT_REPLAY",
        "SMOKE_REPLAY_CONFLICT"
      ]
    },
    "authority_granted": {
      "type": "boolean",
      "const": false
    },
    "smoke_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "detail"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["ok", "skipped", "failed"] },
          "detail": { "type": "string" }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "committed_before_execution", "reconciled"],
      "properties": {
        "checkpoint_id": { "type": "string" },
        "committed_before_execution": { "type": "boolean" },
        "reconciled": { "type": "boolean" },
        "interrupted": { "type": "boolean" }
      }
    },
    "tool_version": {
      "type": "string",
      "description": "Version/identifier of the underlying smoke verifier that was wrapped."
    },
    "run_started_at": { "type": "string" },
    "run_ended_at": { "type": "string" },
    "entries_verified": { "type": "integer", "minimum": 0 },
    "reject_detail": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "reason", "detail"],
        "properties": {
          "target": { "type": "string" },
          "source": { "type": ["string", "null"] },
          "reason": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "detail": { "type": "string" }
  },
  "definitions": {
    "reasonCode": {
      "type": "string",
      "enum": [
        "SMOKE_VERIFICATION_PASS",
        "SMOKE_MANIFEST_INVALID",
        "SMOKE_REQUIRED_TARGET_MISSING",
        "SMOKE_HASH_MISMATCH",
        "SMOKE_EXTRACTION_FAILED",
        "SMOKE_LOAD_FAILED",
        "SMOKE_TIMEOUT",
        "SMOKE_ENVIRONMENT_UNSAFE",
        "SMOKE_RESULT_UNKNOWN",
        "SMOKE_IDEMPOTENT_REPLAY",
        "SMOKE_REPLAY_CONFLICT"
      ]
    }
  }
}
