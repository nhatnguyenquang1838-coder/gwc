{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/node-architect/scrum841-m1-m7-runtime-profile.schema.json",
  "title": "SCRUM-841 M1-M7 runtime profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "task_id", "profile_id", "workflow_id", "repository", "base_ref", "base_sha", "target_ref", "target_sha", "working_branch", "scope_hash", "runtime_plan_digest", "activity_source_sha256", "workflow_manifest_ref", "authorized_paths", "authorized_actions", "max_children", "max_parallel", "observer_mode", "host_request_mode", "native_loop_owner", "native_loop_settlement_by_graph", "external_effects_by_graph", "checkpoint_io_by_graph", "q0_authority_reused", "q0_runtime_plan_reused", "q0_qualification_profile_reused", "global_dependency_change", "authority_granted"],
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "scrum841-m1-m7-runtime-profile"},
    "task_id": {"const": "SCRUM-841"},
    "profile_id": {"const": "SCRUM841_M1_M7_LANGGRAPH_R1"},
    "workflow_id": {"const": "scrum841-m1-m7-agent-workflow-r1"},
    "repository": {"const": "nhatnguyenquang1838-coder/gwc"},
    "base_ref": {"const": "main"},
    "base_sha": {"$ref": "#/$defs/sha40"},
    "target_ref": {"type": "string", "minLength": 1},
    "target_sha": {"$ref": "#/$defs/sha40"},
    "working_branch": {"type": "string", "pattern": "^hermes/SCRUM-841-[a-z0-9-]+$"},
    "scope_hash": {"$ref": "#/$defs/digest"},
    "runtime_plan_digest": {"$ref": "#/$defs/digest"},
    "activity_source_sha256": {"$ref": "#/$defs/digest"},
    "workflow_manifest_ref": {"type": "string", "const": "core/node-architect/scrum841-m1-m7-agent-workflow-r1.json"},
    "authorized_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authorized_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["create_guarded_branch_or_worktree", "modify_approved_files", "run_sandboxed_validation"]}},
    "max_children": {"const": 0},
    "max_parallel": {"const": 1},
    "observer_mode": {"type": "string", "minLength": 1},
    "host_request_mode": {"type": "string", "minLength": 1},
    "native_loop_owner": {"const": "hermes_host"},
    "native_loop_settlement_by_graph": {"const": false},
    "external_effects_by_graph": {"const": false},
    "checkpoint_io_by_graph": {"const": false},
    "q0_authority_reused": {"const": false},
    "q0_runtime_plan_reused": {"const": false},
    "q0_qualification_profile_reused": {"const": false},
    "global_dependency_change": {"const": false},
    "authority_granted": {"const": false}
  }
}
