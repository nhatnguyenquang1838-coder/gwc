{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gwc.dev/schemas/node-architect/universal-run/child-run-materialization-receipt.schema.json",
  "title": "Universal Run ChildRun materialization receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id","schema_id","schema_version","run_id","created_at","created_by","lifecycle_profile","provenance","parent_run_ref","node_allocation_ref","node_allocation_id","child_run_ref","generation","materialization_reason","rerun_of","child_instance_policy","content_digest"],
  "properties": {
    "record_id":{"type":"string","minLength":1},
    "schema_id":{"const":"gwc.universal-run.child-run-materialization-receipt"},
    "schema_version":{"const":1},
    "run_id":{"type":"string","minLength":1},
    "created_at":{"type":"string","minLength":1},
    "created_by":{"type":"object"},
    "lifecycle_profile":{"type":"object","required":["id","version"],"additionalProperties":false,"properties":{"id":{"const":"gwc.universal-run"},"version":{"const":1}}},
    "provenance":{"type":"object","required":["predecessor_refs","source_refs"],"additionalProperties":false,"properties":{"predecessor_refs":{"type":"array","items":{"type":"string"}},"source_refs":{"type":"array","items":{"type":"string"}}}},
    "parent_run_ref":{"type":"string","minLength":1},
    "node_allocation_ref":{"type":"string","minLength":1},
    "node_allocation_id":{"type":"string","minLength":1},
    "child_run_ref":{"type":"string","minLength":1},
    "generation":{"type":"integer","minimum":1},
    "materialization_reason":{"enum":["INITIAL","RERUN_SUBTREE"]},
    "rerun_of":{"type":["string","null"]},
    "child_instance_policy":{"const":"SINGLE_ACTIVE"},
    "content_digest":{"type":"object","required":["algorithm","canonicalization","value"],"additionalProperties":false,"properties":{"algorithm":{"const":"sha256"},"canonicalization":{"const":"JCS"},"value":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
  }
}
