{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gwc.dev/schemas/node-architect/universal-run/v2/controller-successor-snapshot.schema.json",
  "title": "Universal Runtime v2 full Controller successor snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "runtime_plan_digest", "candidate_sha", "sequence", "active_gate", "next_owner", "typed_next", "transition_ref", "successor_state_digest", "successor_run_state", "snapshot_digest"],
  "properties": {
    "schema_id": {"const": "gwc.universal-run.controller-successor-snapshot.v2"},
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "runtime_plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "active_gate": {"enum": ["UR.G0", "UR.G1", "UR.G2", "UR.G3", "UR.G4", "UR.G5", "UR.G6"]},
    "next_owner": {"enum": ["CONTROLLER", "EXECUTOR"]},
    "typed_next": {"type": "string", "minLength": 1},
    "transition_ref": {"type": "string", "minLength": 1},
    "successor_state_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "successor_run_state": {"type": "object", "required": ["schema_id", "schema_version", "run_id", "sequence", "active_gate", "next_owner", "typed_next", "state_digest"]},
    "snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
