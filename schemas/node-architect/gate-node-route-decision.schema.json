{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/node-architect/gate-node-route-decision.schema.json",
  "title": "Gate Node Route Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "task_id", "gate", "requested_action",
    "workflow_mode", "profile_id", "profile_revision", "graph_revision",
    "route_id", "outcome", "current_node", "implementation",
    "node_instruction_ref", "instruction_digest", "instruction_validated",
    "evidence_contract_valid", "log_contract_valid",
    "next_route_contract_valid", "mode_runtime_required",
    "required_context", "loaded_context", "next_node", "next_action",
    "next_gate", "reason_code", "reason_codes", "decision_digest",
    "authority_granted", "write_authority_granted", "pr_authority_granted",
    "merge_authority_granted", "deployment_authority_granted",
    "production_authority_granted"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "artifact_type": {"const": "gate-node-route-decision"},
    "task_id": {"type": "string", "minLength": 1},
    "gate": {"type": "string", "minLength": 1},
    "requested_action": {"type": "string", "minLength": 1},
    "workflow_mode": {"enum": ["normal", "fastlane", "e2e", "hotfix", "rescue"]},
    "profile_id": {"type": "string"},
    "profile_revision": {"type": "string"},
    "graph_revision": {"type": "string"},
    "route_id": {"type": ["string", "null"]},
    "outcome": {"enum": ["ROUTE_SELECTED", "BLOCKED"]},
    "current_node": {"type": ["string", "null"]},
    "implementation": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["python", "connector", "resolver"]},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "node_instruction_ref": {"type": ["string", "null"]},
    "instruction_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "instruction_validated": {"type": "boolean"},
    "evidence_contract_valid": {"type": "boolean"},
    "log_contract_valid": {"type": "boolean"},
    "next_route_contract_valid": {"type": "boolean"},
    "mode_runtime_required": {"type": "boolean"},
    "required_context": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "loaded_context": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "next_node": {"type": ["string", "null"]},
    "next_action": {"type": ["string", "null"]},
    "next_gate": {"type": ["string", "null"]},
    "reason_code": {"type": "string", "minLength": 1},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority_granted": {"const": false},
    "write_authority_granted": {"const": false},
    "pr_authority_granted": {"const": false},
    "merge_authority_granted": {"const": false},
    "deployment_authority_granted": {"const": false},
    "production_authority_granted": {"const": false}
  }
}
