{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/node-architect/destination-trust-profile.schema.json",
  "title": "Destination Trust Profile",
  "description": "SCRUM-533 registration authority for external-audit delivery destinations. Registration is a reviewed entry in destination-trust-registry.json; no dynamic runtime destination creation. Credentials are references only, never inline secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "destination_id",
    "destination_type",
    "receiver_identity",
    "auth",
    "transport_policy",
    "revocation",
    "destination_policy_digest"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "destination-trust-profile" },
    "destination_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "destination_type": { "enum": ["webhook_http", "event_bus", "siem", "kafka", "syslog_tls"] },
    "receiver_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "subject_alt_name": { "type": "string", "minLength": 1 },
        "certificate_fingerprint": { "type": "string", "pattern": "^[0-9a-fA-F:]{40,}$" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme"],
      "properties": {
        "scheme": { "enum": ["hmac_sha256", "mTLS", "bearer_token_ref", "aws_sigv4"] },
        "credential_ref": { "type": "string", "minLength": 1 },
        "credential_version": { "type": "integer", "minimum": 1 }
      }
    },
    "transport_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tls_required", "allow_redirect", "allow_private_ip"],
      "properties": {
        "tls_required": { "const": true },
        "allow_redirect": { "const": false },
        "allow_private_ip": { "const": false },
        "dns_pin": { "type": ["string", "null"], "minLength": 1 },
        "egress_allowlist": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revoked_at", "revoke_reason"],
      "properties": {
        "revoked_at": { "type": ["string", "null"], "format": "date-time" },
        "revoke_reason": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "destination_policy_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
