{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Node Architect route pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario", "families", "runtime_executable", "provenance"],
  "properties": {
    "scenario": {"type": "string", "minLength": 1},
    "families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "runtime_executable": {"const": true},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "kind"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "kind": {"enum": ["source_backed_design"]}
      }
    }
  }
}
