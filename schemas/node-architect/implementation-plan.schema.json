{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dw-super.local/schemas/node-architect/implementation-plan.schema.json",
  "title": "Node Architect Implementation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "research_parent", "planning_base_sha",
    "implementation_scope_hash", "objective", "non_goals", "requirement_to_change",
    "work_packages", "test_matrix", "observability", "rollback",
    "acceptance_criteria", "risks", "pr_slicing", "gate_path",
    "grants_execution_authority", "state", "next_state"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "implementation-plan"},
    "research_parent": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$"},
    "planning_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "implementation_scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "objective": {"type": "string", "minLength": 1},
    "non_goals": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "requirement_to_change": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["requirement", "changes"],
        "properties": {
          "requirement": {"type": "string", "minLength": 1},
          "changes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "work_packages": {
      "type": "array", "minItems": 3, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "objective", "depends_on"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
          "objective": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "test_matrix": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "observability": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "pr_slicing": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "gate_path": {
      "oneOf": [
        {"const": ["G0", "G1", "G2", "G3", "G4", "G5"]},
        {"const": ["G0", "G1", "G2", "G3", "G4", "G5", "G6"]}
      ]
    },
    "grants_execution_authority": {"const": false},
    "state": {"const": "IMPLEMENTATION_PLAN_READY"},
    "next_state": {"const": "AWAITING_G2_AUTHORITY"}
  }
}
