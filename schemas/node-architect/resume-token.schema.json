{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/node-architect/resume-token.schema.json",
  "title": "GWC Resume Token",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "node_id",
    "gate",
    "scope_hash",
    "base_sha",
    "head_sha",
    "resume_token_id",
    "checkpoint_id",
    "state_digest",
    "lease_token",
    "fencing_token",
    "issued_at_utc",
    "expires_at_utc",
    "next_gate",
    "next_action",
    "requires_human_approval",
    "approval_envelope_ref",
    "audit_projection"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "task_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9-]+$"},
    "gate": {"const": "G2_EXECUTION"},
    "scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "resume_token_id": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "state_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "lease_token": {"type": "string", "minLength": 1},
    "fencing_token": {"type": "string", "minLength": 1},
    "issued_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "next_gate": {
      "enum": [
        "G0_CONTEXT",
        "G1_ALIGNMENT",
        "G2_EXECUTION",
        "G3_PR",
        "G4_MERGE",
        "G5_DEPLOY",
        "G6_PRODUCTION_DATA"
      ]
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "requires_human_approval": {
      "type": "boolean"
    },
    "approval_envelope_ref": {"type": ["string", "null"], "minLength": 1},
    "approval_command": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^APPROVE (G2|G3|G4|G5|G6) [A-Za-z0-9._:-]+ [0-9a-f]{16} [0-9T:\\-]+Z$"
    },
    "audit_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_of_truth",
        "links"
      ],
      "properties": {
        "source_of_truth": {
          "const": false
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "authority_granted": {"const": false},
    "write_authority_granted": {"const": false},
    "merge_authority_granted": {"const": false},
    "deployment_authority_granted": {"const": false},
    "production_authority_granted": {"const": false},
    "token_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
