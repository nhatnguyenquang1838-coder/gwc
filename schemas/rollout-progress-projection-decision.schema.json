{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/rollout-progress-projection-decision.schema.json",
  "title": "Rollout Progress Projection",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "repository",
    "branch",
    "base_sha",
    "head_sha",
    "projection_status",
    "reason_code",
    "read_only_projection",
    "decision_digest",
    "observed_at",
    "merge_authority_granted",
    "deployment_authority_granted",
    "production_authority_granted",
    "scale_authority_granted",
    "audit_authority_granted"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "rollout-progress-projection-decision"},
    "task_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "branch": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "projection_status": {"enum": ["READY_FOR_AUDIT_HANDOFF", "IN_PROGRESS", "BLOCKED"]},
    "reason_code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "read_only_projection": {"const": true},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "merge_authority_granted": {"const": false},
    "deployment_authority_granted": {"const": false},
    "production_authority_granted": {"const": false},
    "scale_authority_granted": {"const": false},
    "audit_authority_granted": {"const": false}
  }
}
