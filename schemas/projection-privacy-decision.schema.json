{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dw-super.local/schemas/projection-privacy-decision.schema.json",
  "title": "Projection Privacy Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "repository",
    "projection_target",
    "source_authority_digest",
    "policy_revision",
    "policy_digest",
    "sanitized_payload",
    "redactions",
    "privacy_status",
    "outcome",
    "reason_code",
    "reason_codes",
    "evaluated_at",
    "read_only_projection",
    "write_authority_granted",
    "approval_authority_granted",
    "merge_authority_granted",
    "deployment_authority_granted",
    "production_authority_granted",
    "sanitized_digest",
    "decision_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "projection-privacy-decision"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "projection_target": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"},
    "source_authority_digest": {"$ref": "#/$defs/digest"},
    "policy_revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "sanitized_payload": {"type": "object"},
    "redactions": {"type": "array", "items": {"$ref": "#/$defs/redaction"}},
    "privacy_status": {"enum": ["APPROVED", "REDACTED", "BLOCKED"]},
    "outcome": {"enum": ["READY", "BLOCKED"]},
    "reason_code": {"$ref": "#/$defs/reason_code"},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reason_code"}},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "read_only_projection": {"const": true},
    "write_authority_granted": {"const": false},
    "approval_authority_granted": {"const": false},
    "merge_authority_granted": {"const": false},
    "deployment_authority_granted": {"const": false},
    "production_authority_granted": {"const": false},
    "sanitized_digest": {"$ref": "#/$defs/digest"},
    "decision_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "classification": {
      "enum": [
        "PUBLIC_METADATA",
        "INTERNAL_METADATA",
        "CONFIDENTIAL_METADATA",
        "PERSONAL_SENSITIVE",
        "SECRET",
        "CREDENTIAL",
        "TOKEN",
        "PRIVATE_KEY",
        "PRODUCTION_DATA",
        "HIDDEN_REASONING",
        "POLICY_REDACTED"
      ]
    },
    "field_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "classification"],
      "properties": {
        "field_path": {"type": "string", "minLength": 1, "maxLength": 512},
        "classification": {"$ref": "#/$defs/classification"}
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "classification", "action", "replacement_token", "reason_code"],
      "properties": {
        "field_path": {"type": "string", "minLength": 1, "maxLength": 512},
        "classification": {"$ref": "#/$defs/classification"},
        "action": {"enum": ["REDACT", "REMOVE"]},
        "replacement_token": {"type": "string", "minLength": 1, "maxLength": 64},
        "reason_code": {"$ref": "#/$defs/reason_code"}
      }
    },
    "reason_code": {"enum": [
      "PRIVACY_APPROVED",
      "PRIVACY_APPROVED_REDACTED",
      "PRIVACY_INPUT_INVALID",
      "PRIVACY_SOURCE_AUTHORITY_INVALID",
      "PRIVACY_CLASSIFICATION_MISSING",
      "PRIVACY_SECRET_REJECTED",
      "PRIVACY_CREDENTIAL_REJECTED",
      "PRIVACY_TOKEN_REJECTED",
      "PRIVACY_PRIVATE_KEY_REJECTED",
      "PRIVACY_PRODUCTION_DATA_REJECTED",
      "PRIVACY_HIDDEN_REASONING_REJECTED",
      "PRIVACY_TARGET_POLICY_DENIED",
      "PRIVACY_REDACTION_DIRECTIVE_INVALID",
      "PRIVACY_PAYLOAD_LIMIT_EXCEEDED",
      "PRIVACY_LEAK_DETECTED",
      "PRIVACY_DIGEST_MISMATCH"
    ]}
  }
}
