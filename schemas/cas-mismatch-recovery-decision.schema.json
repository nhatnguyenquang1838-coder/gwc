{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/cas-mismatch-recovery-decision.schema.json",
  "title": "GWC CAS Mismatch Recovery Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "task_id", "repository", "branch", "base_sha", "head_sha", "scope_hash", "checkpoint_id", "expected_revision", "observed_revision", "reload_status", "pending_action_status", "retry_count", "max_retries", "observed_at", "outcome", "reason_code", "overwrite_allowed", "blind_retry_allowed", "checkpoint_required", "decision_digest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "cas-mismatch-recovery-decision"},
    "task_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "branch": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "expected_revision": {"type": "integer", "minimum": 0},
    "observed_revision": {"type": "integer", "minimum": 0},
    "reload_status": {"enum": ["VERIFIED", "UNAVAILABLE", "STALE"]},
    "pending_action_status": {"enum": ["NONE", "PENDING", "UNKNOWN", "COMMITTED"]},
    "retry_count": {"type": "integer", "minimum": 0},
    "max_retries": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string", "format": "date-time"},
    "outcome": {"enum": ["NO_MISMATCH", "RELOAD", "RECONCILE", "RETRY_AFTER_RELOAD", "HUMAN_REQUIRED", "FAIL"]},
    "reason_code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "overwrite_allowed": {"const": false},
    "blind_retry_allowed": {"const": false},
    "checkpoint_required": {"type": "boolean"},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
