{
  "$id": "https://gwc.local/schemas/client-runtime-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "additionalProperties": true,
      "type": "object"
    },
    "protected_base_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "repository": {
      "pattern": "^[^/]+/[^/]+$",
      "type": "string"
    },
    "route_intent": {
      "const": "client-runtime-node-architect-vertical-slice"
    },
    "route_nodes": {
      "items": false,
      "maxItems": 7,
      "minItems": 7,
      "prefixItems": [
        {
          "const": "client_request"
        },
        {
          "const": "route_scenario_validation"
        },
        {
          "const": "repo_delivery.ci-run-capture"
        },
        {
          "const": "runtime_checkpoint.checkpoint-persist"
        },
        {
          "const": "validation_quality.ci-evidence-capture"
        },
        {
          "const": "validation_quality.evidence-quality-check"
        },
        {
          "const": "validation_quality.g3-pass-decision"
        }
      ],
      "type": "array"
    },
    "scenario_id": {
      "minLength": 1,
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "repository",
    "protected_base_sha",
    "scenario_id",
    "route_intent",
    "route_nodes"
  ],
  "title": "GWC Client Runtime Request",
  "type": "object"
}
