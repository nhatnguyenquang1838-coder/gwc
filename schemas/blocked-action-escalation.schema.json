{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/blocked-action-escalation.schema.json",
  "title": "GWC Blocked Action Escalation",
  "description": "Replay-safe escalation decision for a blocked action. Converts unauthorized/stale/expired/unsupported/unknown-evidence actions into one deterministic BLOCKED/HUMAN_REQUIRED outcome with the minimum legal remediation. Never performs the action; zero protected side effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "repository",
    "blocked_action",
    "authority_check",
    "evidence_available",
    "decision",
    "escalation_class",
    "execution_performed",
    "reason_code",
    "escalation_digest"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "artifact_type": { "const": "blocked-action-escalation" },
    "task_id": { "type": "string", "pattern": "^SCRUM-[0-9]+$" },
    "repository": { "type": "string", "minLength": 1 },
    "blocked_action": { "type": "string", "minLength": 1 },
    "authority_check": {
      "type": "string",
      "enum": ["UNSUPPORTED", "UNAUTHORIZED", "STALE", "EXPIRED", "UNKNOWN", "OK"]
    },
    "evidence_available": { "type": "boolean" },
    "decision": {
      "type": "string",
      "enum": ["BLOCKED", "HUMAN_REQUIRED", "WAIT", "RESOLVE_MINIMAL"]
    },
    "escalation_class": {
      "type": "string",
      "enum": [
        "REMEDIATE_EVIDENCE",
        "RECAPTURE_BASE_OR_HEAD",
        "REVALIDATE_SCOPE",
        "REQUEST_G2_APPROVAL",
        "REQUEST_G4_APPROVAL",
        "REQUEST_G5_MANUAL_APPROVAL",
        "REQUEST_G6_APPROVAL",
        "WAIT_FOR_READBACK",
        "WAIT_FOR_CI",
        "REQUEST_HUMAN_INPUT",
        "TERMINAL_STOP"
      ]
    },
    "checkpoint_required": { "type": "boolean" },
    "remediation_scope": {
      "type": ["string", "null"],
      "description": "Minimal exact remediation, or null when not applicable."
    },
    "execution_performed": { "const": false },
    "reason_code": { "type": "string", "pattern": "^ESCALATION_[A-Z_]+$" },
    "replay_status": { "type": "string", "enum": ["IDEMPOTENT", "CONFLICT"] },
    "escalation_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
