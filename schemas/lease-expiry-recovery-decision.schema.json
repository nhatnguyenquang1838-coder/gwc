{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/lease-expiry-recovery-decision.schema.json",
  "title": "Lease Expiry Recovery Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "repository",
    "branch",
    "base_sha",
    "head_sha",
    "scope_hash",
    "lease_id",
    "worker_id",
    "now_epoch_ms",
    "lease_expires_epoch_ms",
    "lease_expired",
    "observed_fencing_token",
    "worker_fencing_token",
    "readback_status",
    "reacquire_status",
    "duplicate_agent_detected",
    "side_effect_status",
    "observed_at",
    "outcome",
    "reason_code",
    "advancement_allowed",
    "side_effect_allowed",
    "reacquire_required",
    "checkpoint_required",
    "blind_retry_allowed",
    "decision_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "lease-expiry-recovery-decision"},
    "task_id": {"type": "string"},
    "repository": {"type": "string"},
    "branch": {"type": "string"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "lease_id": {"type": "string"},
    "worker_id": {"type": "string"},
    "now_epoch_ms": {"type": "integer", "minimum": 0},
    "lease_expires_epoch_ms": {"type": "integer", "minimum": 0},
    "lease_expired": {"type": "boolean"},
    "observed_fencing_token": {"type": "integer", "minimum": 0},
    "worker_fencing_token": {"type": "integer", "minimum": 0},
    "readback_status": {"type": "string", "enum": ["VERIFIED_ZERO_EFFECT", "UNAVAILABLE", "UNKNOWN", "PARTIAL"]},
    "reacquire_status": {"type": "string", "enum": ["REACQUIRED_MONOTONIC", "NOT_REACQUIRED", "FAILED", "UNKNOWN"]},
    "duplicate_agent_detected": {"type": "boolean"},
    "side_effect_status": {"type": "string", "enum": ["NONE", "PENDING", "UNKNOWN", "COMMITTED"]},
    "observed_at": {"type": "string"},
    "outcome": {"type": "string", "enum": ["CONTINUE", "READBACK_REQUIRED", "FENCE_STALE_WORKER", "FENCE_DUPLICATE_AGENT", "RECONCILE", "REACQUIRE_LEASE", "CONTINUE_AFTER_REACQUIRE"]},
    "reason_code": {"type": "string"},
    "advancement_allowed": {"type": "boolean"},
    "side_effect_allowed": {"type": "boolean"},
    "reacquire_required": {"type": "boolean"},
    "checkpoint_required": {"type": "boolean"},
    "blind_retry_allowed": {"const": false},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
