{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/diff-readback-decision.schema.json",
  "title": "diff-readback-decision",
  "type": "object",
  "required": ["outcome", "reason_codes", "repository", "base_sha", "head_sha", "branch", "changed_paths", "additions", "deletions", "decision_digest", "merge_authority_granted", "deployment_authority_granted", "production_authority_granted"],
  "properties": {
    "outcome": {"enum": ["PASS", "BLOCKED", "HUMAN_REQUIRED"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "repository": {"type": "string"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$|^$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$|^$"},
    "branch": {"type": "string"},
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "additions": {"type": "integer"},
    "deletions": {"type": "integer"},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "merge_authority_granted": {"const": false},
    "deployment_authority_granted": {"const": false},
    "production_authority_granted": {"const": false}
  },
  "additionalProperties": false
}
