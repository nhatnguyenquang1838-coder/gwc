{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/catalog-cardinality-readiness-decision.schema.json",
  "title": "Catalog Cardinality Readiness Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "repository",
    "branch",
    "base_sha",
    "head_sha",
    "merge_authority_granted",
    "deployment_authority_granted",
    "production_authority_granted",
    "audit_authority_granted",
    "scale_authority_granted",
    "reason_code",
    "observed_at",
    "decision_digest",
    "catalog_revision",
    "expected_revision",
    "expected_family_count",
    "expected_nodes_per_family",
    "expected_total_nodes",
    "observed_family_count",
    "observed_node_count",
    "observed_unique_node_count",
    "family_size_violations",
    "duplicate_node_ids",
    "missing_node_ids",
    "unexpected_node_ids",
    "readiness_passed",
    "outcome"
  ],
  "properties": {
    "artifact_type": {"const": "catalog-cardinality-readiness-decision"},
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "merge_authority_granted": {"const": false},
    "deployment_authority_granted": {"const": false},
    "production_authority_granted": {"const": false},
    "audit_authority_granted": {"const": false},
    "scale_authority_granted": {"const": false},
    "reason_code": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "catalog_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "expected_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "expected_family_count": {"type": "integer", "minimum": 1},
    "expected_nodes_per_family": {"type": "integer", "minimum": 1},
    "expected_total_nodes": {"type": "integer", "minimum": 1},
    "observed_family_count": {"type": "integer", "minimum": 0},
    "observed_node_count": {"type": "integer", "minimum": 0},
    "observed_unique_node_count": {"type": "integer", "minimum": 0},
    "family_size_violations": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "duplicate_node_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "missing_node_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unexpected_node_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "readiness_passed": {"type": "boolean"},
    "outcome": {"enum": ["READY", "BLOCKED"]}
  }
}
