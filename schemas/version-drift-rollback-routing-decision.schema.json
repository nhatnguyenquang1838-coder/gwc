{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/version-drift-rollback-routing-decision.schema.json",
  "title": "Version Drift Rollback Routing Decision",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "repository",
    "branch",
    "base_sha",
    "head_sha",
    "scope_hash",
    "run_id",
    "checkpoint_id",
    "snapshot_node_version",
    "runtime_node_version",
    "drift_detected",
    "compatibility_rule",
    "replay_requested",
    "replay_epoch",
    "current_epoch",
    "stale_replay",
    "replay_allowed",
    "new_epoch_required",
    "governed_repair_required",
    "rollback_route_required",
    "evidence_preserved",
    "g5_manual_action_authorized",
    "outcome",
    "reason_code",
    "observed_at",
    "decision_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "version-drift-rollback-routing-decision"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "compatibility_rule": {"enum": ["COMPATIBLE", "NEW_EPOCH_REQUIRED", "GOVERNED_REPAIR_REQUIRED", "ROLLBACK_REQUIRED", "UNKNOWN"]},
    "g5_manual_action_authorized": {"const": false},
    "outcome": {"enum": ["CONTINUE", "CONTINUE_COMPATIBLE", "ROUTE_NEW_EPOCH", "ROUTE_GOVERNED_REPAIR", "ROUTE_ROLLBACK_EVIDENCE", "REJECT_STALE_REPLAY", "BLOCK_UNSUPPORTED_DRIFT"]},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
