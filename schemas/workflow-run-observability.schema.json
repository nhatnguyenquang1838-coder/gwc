{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/workflow-run-observability-decision.schema.json",
  "title": "Workflow Run Observability Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "repository",
    "branch",
    "base_sha",
    "head_sha",
    "merge_authority_granted",
    "deployment_authority_granted",
    "production_authority_granted",
    "audit_authority_granted",
    "scale_authority_granted",
    "reason_code",
    "observed_at",
    "decision_digest",
    "expected_event",
    "expected_branch",
    "expected_head_sha",
    "required_workflow_names",
    "connector_status",
    "exact_filter_applied",
    "observed_run_count",
    "exact_run_count",
    "selected_run_count",
    "superseded_run_count",
    "mismatched_run_count",
    "missing_workflow_names",
    "pending_workflow_names",
    "failed_workflow_names",
    "successful_workflow_names",
    "slo_ready_metrics",
    "observation_complete",
    "read_only_projection",
    "classification"
  ],
  "properties": {
    "artifact_type": {"const": "workflow-run-observability-decision"},
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "merge_authority_granted": {"const": false},
    "deployment_authority_granted": {"const": false},
    "production_authority_granted": {"const": false},
    "audit_authority_granted": {"const": false},
    "scale_authority_granted": {"const": false},
    "reason_code": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "expected_event": {"type": "string", "minLength": 1},
    "expected_branch": {"type": "string", "minLength": 1},
    "expected_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "required_workflow_names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "connector_status": {"enum": ["CONFIRMED", "EMPTY", "ERROR", "UNSUPPORTED"]},
    "exact_filter_applied": {"type": "boolean"},
    "observed_run_count": {"type": "integer", "minimum": 0},
    "exact_run_count": {"type": "integer", "minimum": 0},
    "selected_run_count": {"type": "integer", "minimum": 0},
    "superseded_run_count": {"type": "integer", "minimum": 0},
    "mismatched_run_count": {"type": "integer", "minimum": 0},
    "missing_workflow_names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "pending_workflow_names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "failed_workflow_names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "successful_workflow_names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "slo_ready_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts_total", "max_duration_seconds", "slo_completion_seconds", "slo_breached"],
      "properties": {
        "attempts_total": {"type": "integer", "minimum": 0},
        "max_duration_seconds": {"type": ["integer", "null"], "minimum": 0},
        "slo_completion_seconds": {"type": "integer", "minimum": 1},
        "slo_breached": {"type": "boolean"}
      }
    },
    "observation_complete": {"type": "boolean"},
    "read_only_projection": {"const": true},
    "classification": {"enum": ["SUCCESS", "CI_PENDING", "CI_FAILED", "RUNS_MISSING", "CONNECTOR_OBSERVABILITY_INCOMPLETE", "INVALID_INPUT"]}
  }
}
