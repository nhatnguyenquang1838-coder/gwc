{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dw-super.local/schemas/projection-evidence-linkset.schema.json",
  "title": "Projection Evidence Linkset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "repository",
    "projection_target",
    "source_authority_digest",
    "links",
    "covered_fields",
    "uncovered_fields",
    "link_status",
    "outcome",
    "reason_code",
    "reason_codes",
    "linked_at",
    "read_only_projection",
    "write_authority_granted",
    "approval_authority_granted",
    "merge_authority_granted",
    "deployment_authority_granted",
    "production_authority_granted",
    "linkset_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "projection-evidence-linkset"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "projection_target": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"},
    "source_authority_digest": {"$ref": "#/$defs/digest"},
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "covered_fields": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/field_path"}},
    "uncovered_fields": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/field_path"}},
    "link_status": {"enum": ["VERIFIED", "BLOCKED"]},
    "outcome": {"enum": ["READY", "BLOCKED"]},
    "reason_code": {"$ref": "#/$defs/reason_code"},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reason_code"}},
    "linked_at": {"type": "string", "format": "date-time"},
    "read_only_projection": {"const": true},
    "write_authority_granted": {"const": false},
    "approval_authority_granted": {"const": false},
    "merge_authority_granted": {"const": false},
    "deployment_authority_granted": {"const": false},
    "production_authority_granted": {"const": false},
    "linkset_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._:/@+\\-]+$"},
    "ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "field_path": {"type": "string", "pattern": "^(?:/[A-Za-z0-9_.~\\-/]+|[a-z][a-z0-9_.-]{0,255})$"},
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_type", "ref", "revision", "content_digest", "relation", "field_paths", "verification_status"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "source_type": {"enum": ["REPOSITORY", "GATE_ARTIFACT", "TASK_RECORD", "PULL_REQUEST", "CI_RUN", "AUDIT_EVENT"]},
        "ref": {"$ref": "#/$defs/ref"},
        "revision": {"$ref": "#/$defs/revision"},
        "content_digest": {"$ref": "#/$defs/digest"},
        "relation": {"enum": ["SUPPORTS_FIELD", "DERIVED_FROM", "VALIDATED_BY", "READBACK_OF", "SUPERSEDES"]},
        "field_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/field_path"}},
        "display_url": {"type": "string", "format": "uri", "maxLength": 2048},
        "verification_status": {"enum": ["VERIFIED", "STALE", "BROKEN", "UNVERIFIED", "CONFLICT"]},
        "supersedes_revision": {"$ref": "#/$defs/revision"}
      },
      "allOf": [{"if": {"properties": {"relation": {"const": "SUPERSEDES"}}, "required": ["relation"]}, "then": {"required": ["supersedes_revision"]}}]
    },
    "reason_code": {"enum": [
      "EVIDENCE_LINKSET_READY",
      "EVIDENCE_LINK_INPUT_INVALID",
      "EVIDENCE_LINK_SOURCE_AUTHORITY_INVALID",
      "EVIDENCE_LINK_REQUIRED_MISSING",
      "EVIDENCE_LINK_IMMUTABLE_REF_MISSING",
      "EVIDENCE_LINK_CONTRACT_INVALID",
      "EVIDENCE_LINK_UNVERIFIED",
      "EVIDENCE_LINK_STALE",
      "EVIDENCE_LINK_BROKEN",
      "EVIDENCE_LINK_DIGEST_CONFLICT",
      "EVIDENCE_LINK_FIELD_UNBOUND",
      "EVIDENCE_LINK_DIGEST_MISMATCH",
      "EVIDENCE_LINK_URL_NOT_AUTHORITY"
    ]}
  }
}
