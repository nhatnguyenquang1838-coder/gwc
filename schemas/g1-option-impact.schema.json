{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/g1-option-impact.schema.json",
  "title": "G1 Option Impact Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "repository",
    "base_sha",
    "generated_at_utc",
    "analysis_source",
    "ua_knowledge",
    "options"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "g1-option-impact"},
    "task_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "analysis_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "task_me"],
      "properties": {
        "method": {"enum": ["task_me", "g1_skill_llm"]},
        "task_me": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicable", "available", "invoked"],
          "properties": {
            "applicable": {"type": "boolean"},
            "available": {"type": "boolean"},
            "invoked": {"type": "boolean"},
            "fallback_reason": {"type": "string"},
            "run_id": {"type": "string"},
            "plan_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      }
    },
    "ua_knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "base_graph", "synthetic_nodes_generated"],
      "properties": {
        "status": {"enum": ["CURRENT", "STALE", "PARTIAL", "EMPTY", "MISSING"]},
        "base_graph": {"enum": ["AVAILABLE", "EMPTY", "MISSING"]},
        "source_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_hashes": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "synthetic_nodes_generated": {"const": false}
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "scores", "impact", "graph_delta"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "selected": {"type": "boolean"},
          "recommendation": {"enum": ["recommended", "acceptable", "rejected", "requires_human_decision"]},
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "complexity", "effort", "risk", "blast_radius"],
            "properties": {
              "value": {"type": "integer", "minimum": 0, "maximum": 10},
              "complexity": {"type": "integer", "minimum": 0, "maximum": 10},
              "effort": {"type": "integer", "minimum": 0, "maximum": 10},
              "risk": {"type": "integer", "minimum": 0, "maximum": 10},
              "blast_radius": {"type": "integer", "minimum": 0, "maximum": 10}
            }
          },
          "impact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary", "files", "symbols", "components", "dependencies", "tests", "rollback"],
            "properties": {
              "summary": {"type": "string", "minLength": 1},
              "files": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "symbols": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "components": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "rollback": {"type": "string", "minLength": 1}
            }
          },
          "graph_delta": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodes_added", "nodes_changed", "edges_added"],
            "properties": {
              "nodes_added": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "nodes_changed": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "edges_added": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"analysis_source": {"properties": {"method": {"const": "task_me"}}}}},
      "then": {"properties": {"analysis_source": {"properties": {"task_me": {"properties": {"invoked": {"const": true}}}}}}}
    },
    {
      "if": {"properties": {"analysis_source": {"properties": {"task_me": {"properties": {"applicable": {"const": true}, "available": {"const": true}, "invoked": {"const": false}}}}}}},
      "then": false
    }
  ]
}
