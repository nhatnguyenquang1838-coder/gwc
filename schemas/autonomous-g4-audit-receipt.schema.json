{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/autonomous-g4-audit-receipt.schema.json",
  "title": "Autonomous G4 Pre-Prod Independent Audit Receipt",
  "type": "object",
  "required": [
    "artifact_type", "schema_version", "audit_outcome", "blockers", "task_id", "repository", "pr_number",
    "target_branch", "base_sha", "head_sha", "dag_digest", "parent_authority_ref", "g0_ref", "g1_ref", "g2_ref",
    "g3_ref", "ci_ref", "managed_evidence_digest", "standing_g4_ref", "auditor_id", "auditor_context_id",
    "auditor_trust_ref", "implementer_id", "implementer_context_id", "independent", "write_actions",
    "merge_authority", "evidence_digest", "receipt_digest"
  ],
  "properties": {
    "artifact_type": {"const": "autonomous-g4-preprod-independent-audit"},
    "schema_version": {"const": "1.1"},
    "audit_outcome": {"enum": ["PASS", "BLOCK"]},
    "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "task_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "pr_number": {"type": "integer", "minimum": 1},
    "target_branch": {"const": "pre-prod"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dag_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "parent_authority_ref": {"type": "string", "minLength": 1},
    "g0_ref": {"type": "string", "minLength": 1},
    "g1_ref": {"type": "string", "minLength": 1},
    "g2_ref": {"type": "string", "minLength": 1},
    "g3_ref": {"type": "string", "minLength": 1},
    "ci_ref": {"type": "string", "minLength": 1},
    "managed_evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "standing_g4_ref": {"type": "string", "minLength": 1},
    "auditor_id": {"type": "string", "minLength": 1},
    "auditor_context_id": {"type": "string", "minLength": 1},
    "auditor_trust_ref": {"type": "string", "minLength": 1},
    "implementer_id": {"type": "string", "minLength": 1},
    "implementer_context_id": {"type": "string", "minLength": 1},
    "independent": {"type": "boolean"},
    "write_actions": {"type": "array", "maxItems": 0},
    "merge_authority": {"const": false},
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
