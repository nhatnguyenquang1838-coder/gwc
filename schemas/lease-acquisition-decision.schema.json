{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/lease-acquisition-decision.schema.json",
  "title": "Lease Acquisition Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "run_id",
    "node_id",
    "gate",
    "base_sha",
    "head_sha",
    "scope_hash",
    "repository",
    "branch",
    "lease_id",
    "actor_id",
    "actor_fencing_token",
    "observed_lease_holder",
    "observed_fencing_token",
    "observed_scope_hash",
    "observed_repository",
    "lease_expired",
    "side_effect_status",
    "readback_status",
    "duplicate_agent_detected",
    "observed_at",
    "outcome",
    "reason_code",
    "advancement_allowed",
    "side_effect_allowed",
    "reacquire_required",
    "fencing_token",
    "fencing_enforced",
    "decision_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "lease-acquisition-decision"},
    "task_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "gate": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "branch": {"type": "string", "minLength": 1},
    "lease_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "actor_fencing_token": {"type": ["integer", "null"], "minimum": 0},
    "observed_lease_holder": {"type": ["string", "null"]},
    "observed_fencing_token": {"type": ["integer", "null"], "minimum": 0},
    "observed_scope_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "observed_repository": {"type": ["string", "null"]},
    "lease_expired": {"type": "boolean"},
    "side_effect_status": {"type": "string", "minLength": 1},
    "readback_status": {"type": "string", "minLength": 1},
    "duplicate_agent_detected": {"type": "boolean"},
    "observed_at": {"type": "string", "format": "date-time"},
    "outcome": {
      "type": "string",
      "enum": [
        "ACQUIRED",
        "FENCE_STALE_WORKER",
        "FENCE_DUPLICATE_AGENT",
        "RECONCILE",
        "REACQUIRE_REQUIRED",
        "SCOPE_MISMATCH"
      ]
    },
    "reason_code": {"type": "string", "minLength": 1},
    "advancement_allowed": {"type": "boolean"},
    "side_effect_allowed": {"type": "boolean"},
    "reacquire_required": {"type": "boolean"},
    "fencing_token": {"type": ["integer", "null"], "minimum": 1},
    "fencing_enforced": {"const": true},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
