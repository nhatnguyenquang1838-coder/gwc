{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.dw/schemas/projection-reconcile-readback.schema.json",
  "title": "Projection Reconcile Readback",
  "schema_version": "1.0",
  "artifact_type": "projection-reconcile-readback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "repository",
    "projection_target",
    "outcome",
    "authority_status",
    "reason_code",
    "reason_codes",
    "current",
    "divergence_fields",
    "canonical_state_digest",
    "read_only_projection",
    "write_authority_granted",
    "approval_authority_granted",
    "merge_authority_granted",
    "deployment_authority_granted",
    "production_authority_granted",
    "decision_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_type": {
      "const": "projection-reconcile-readback"
    },
    "task_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$"
    },
    "repository": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "projection_target": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
    },
    "outcome": {
      "enum": ["READY", "BLOCKED", "CONFIRMED", "PENDING", "CONFLICT", "UNAVAILABLE"]
    },
    "authority_status": {
      "enum": ["CONFIRMED", "REJECTED"]
    },
    "reason_code": {
      "type": "string"
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "current": {
      "type": "boolean"
    },
    "divergence_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canonical_state_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_revision": {
      "type": ["string", "null"]
    },
    "idempotency_identity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["task_id", "idempotency_key"],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        }
      }
    },
    "observed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "read_only_projection": {
      "const": true
    },
    "write_authority_granted": {
      "const": false
    },
    "approval_authority_granted": {
      "const": false
    },
    "merge_authority_granted": {
      "const": false
    },
    "deployment_authority_granted": {
      "const": false
    },
    "production_authority_granted": {
      "const": false
    },
    "decision_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
