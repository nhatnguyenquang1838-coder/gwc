{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/crash-checkpoint-recovery-decision.schema.json",
  "title": "GWC Crash Checkpoint Recovery Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "repository",
    "branch",
    "base_sha",
    "head_sha",
    "scope_hash",
    "run_id",
    "checkpoint_id",
    "checkpoint_revision",
    "checkpoint_status",
    "pending_action_status",
    "readback_status",
    "effect_status",
    "idempotency_key",
    "resume_token",
    "observed_at",
    "outcome",
    "reason_code",
    "checkpoint_required",
    "readback_required_before_effect",
    "duplicate_effect_allowed",
    "decision_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "crash-checkpoint-recovery-decision"},
    "task_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "branch": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "checkpoint_revision": {"type": "integer", "minimum": 0},
    "checkpoint_status": {"enum": ["CANONICAL", "STALE", "MISSING"]},
    "pending_action_status": {"enum": ["NONE", "IN_FLIGHT", "COMPLETED", "STALE"]},
    "readback_status": {"enum": ["VERIFIED", "UNAVAILABLE", "STALE"]},
    "effect_status": {"enum": ["ZERO_EFFECT", "COMMITTED", "UNKNOWN", "FAILED", "NOT_APPLICABLE"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "resume_token": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "outcome": {"enum": ["RESUME", "RECONCILE", "FAIL", "HUMAN_REQUIRED"]},
    "reason_code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "checkpoint_required": {"type": "boolean"},
    "readback_required_before_effect": {"type": "boolean"},
    "duplicate_effect_allowed": {"type": "boolean"},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
