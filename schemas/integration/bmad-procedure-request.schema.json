{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/integration/bmad-procedure-request.schema.json",
  "title": "BMAD Procedure Adapter Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "task_id",
    "gwc_run_id",
    "repository",
    "procedure",
    "adapter_version",
    "scope_hash",
    "permission",
    "expected_outputs",
    "timeout_seconds",
    "retry",
    "idempotency_key",
    "provider"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]+$"
    },
    "gwc_run_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name",
        "base_sha"
      ],
      "properties": {
        "full_name": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "enum": [
            "architecture-analysis",
            "story-preparation",
            "tdd-implementation",
            "code-review",
            "release-readiness"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "scope_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "permission": {
      "$ref": "bmad-permission-model.schema.json"
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "backoff_seconds"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "backoff_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repo",
        "source_commit",
        "source_version",
        "state"
      ],
      "properties": {
        "source_repo": {
          "const": "nhatnguyenquang1838-coder/BMAD-METHOD"
        },
        "source_commit": {
          "const": "bb45db4aa4496c69239f9c0629c290fd1b072fc9"
        },
        "source_version": {
          "const": "6.10.0"
        },
        "state": {
          "enum": [
            "published",
            "ready-unpublished"
          ]
        }
      }
    },
    "ua_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "task_me_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "resume": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "request_digest",
        "checkpoint_revision"
      ],
      "properties": {
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "checkpoint_revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
