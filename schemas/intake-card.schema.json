{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/intake-card.schema.json",
  "title": "Intake Card",
  "description": "A deterministic, immutable and redacted read-only intake projection from verified upstream artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "contract_revision",
    "task_id",
    "repository",
    "base_sha",
    "request",
    "source_bindings",
    "repository_context",
    "risk_projection",
    "read_scope_projection",
    "write_scope_projection",
    "upstream_artifacts",
    "context_status",
    "outcome",
    "next_required_action",
    "scope_hash",
    "snapshot_hash",
    "redaction_status",
    "redactions",
    "reason_code",
    "reason_codes",
    "created_at",
    "read_only_projection",
    "write_authority_granted",
    "commit_authority_granted",
    "push_authority_granted",
    "pr_authority_granted",
    "merge_authority_granted",
    "deployment_authority_granted",
    "production_authority_granted"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_type": {
      "const": "intake-card"
    },
    "contract_revision": {
      "const": "intake-context/v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "outcome",
        "constraints",
        "exclusions"
      ],
      "properties": {
        "intent": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "constraints": {
          "$ref": "#/$defs/uniqueStringArray"
        },
        "exclusions": {
          "$ref": "#/$defs/uniqueStringArray"
        }
      }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "binding",
          "revision"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "binding": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "REPO",
              "PACKAGE",
              "MIXED"
            ]
          },
          "status": {
            "enum": [
              "VERIFIED",
              "STALE",
              "MISSING",
              "AMBIGUOUS",
              "CONFLICT"
            ]
          }
        }
      }
    },
    "repository_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "protected_branch",
        "protected_base_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "protected_branch": {
          "type": "string",
          "minLength": 1
        },
        "protected_base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "risk_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "risk_level",
        "risk_flags",
        "required_gate",
        "additional_authority_gates",
        "risk_profile_digest"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "READY",
            "BLOCKED"
          ]
        },
        "risk_level": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            null
          ]
        },
        "risk_flags": {
          "$ref": "#/$defs/uniqueStringArray"
        },
        "required_gate": {
          "enum": [
            "G0_CONTEXT",
            "G2_EXECUTION"
          ]
        },
        "additional_authority_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "G5_DEPLOY",
              "G6_PRODUCTION_DATA"
            ]
          }
        },
        "risk_profile_digest": {
          "$ref": "#/$defs/optionalHash"
        }
      }
    },
    "read_scope_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "failure_classification",
        "files_read",
        "files_exclude",
        "files_missing",
        "read_scope_hash"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "READY",
            "BLOCKED"
          ]
        },
        "failure_classification": {
          "enum": [
            null,
            "NONE",
            "AGENT_PREPARATION_BLOCKED",
            "REPOSITORY_EVIDENCE_MISSING",
            "VALIDATION_FAILED"
          ]
        },
        "files_read": {
          "$ref": "#/$defs/uniqueStringArray"
        },
        "files_exclude": {
          "$ref": "#/$defs/uniqueStringArray"
        },
        "files_missing": {
          "$ref": "#/$defs/uniqueStringArray"
        },
        "read_scope_hash": {
          "$ref": "#/$defs/optionalHash"
        }
      }
    },
    "write_scope_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "candidate_paths",
        "exclusions",
        "prohibited_operations",
        "branch_binding_status",
        "required_authority_gates",
        "write_scope_hash"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "READY",
            "BLOCKED"
          ]
        },
        "candidate_paths": {
          "$ref": "#/$defs/uniqueStringArray"
        },
        "exclusions": {
          "$ref": "#/$defs/uniqueStringArray"
        },
        "prohibited_operations": {
          "$ref": "#/$defs/uniqueStringArray"
        },
        "branch_binding_status": {
          "enum": [
            "BOUND",
            "REQUIRED_AT_G2",
            "UNBOUND"
          ]
        },
        "required_authority_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "G2_EXECUTION",
              "G5_DEPLOY",
              "G6_PRODUCTION_DATA"
            ]
          }
        },
        "write_scope_hash": {
          "$ref": "#/$defs/optionalHash"
        }
      }
    },
    "upstream_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_type",
          "schema_version",
          "digest"
        ],
        "properties": {
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "schema_version": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^(?:sha256:)?[0-9a-f]{64}$"
          }
        }
      }
    },
    "context_status": {
      "enum": [
        "READY",
        "BLOCKED"
      ]
    },
    "outcome": {
      "enum": [
        "READY",
        "BLOCKED"
      ]
    },
    "next_required_action": {
      "enum": [
        "CONTINUE_CONTEXT_EVALUATION",
        "ESCALATE_CONTEXT_GAP"
      ]
    },
    "scope_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "redaction_status": {
      "enum": [
        "NONE",
        "APPLIED",
        "BLOCKED"
      ]
    },
    "redactions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pointer",
          "classification",
          "replacement",
          "reason_code"
        ],
        "properties": {
          "pointer": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "SECRET",
              "CREDENTIAL",
              "TOKEN",
              "PRIVATE_KEY",
              "PERSONAL_SENSITIVE",
              "POLICY_REDACTED"
            ]
          },
          "replacement": {
            "const": "[REDACTED]"
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string"
    },
    "read_only_projection": {
      "const": true
    },
    "write_authority_granted": {
      "const": false
    },
    "commit_authority_granted": {
      "const": false
    },
    "push_authority_granted": {
      "const": false
    },
    "pr_authority_granted": {
      "const": false
    },
    "merge_authority_granted": {
      "const": false
    },
    "deployment_authority_granted": {
      "const": false
    },
    "production_authority_granted": {
      "const": false
    }
  },
  "$defs": {
    "uniqueStringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "optionalHash": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{64})?$"
    }
  }
}
