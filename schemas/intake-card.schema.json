{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/intake-card.schema.json",
  "title": "Intake Card",
  "description": "A deterministic, immutable and redacted intake_card projection from verified upstream artifacts. Read-only G0_CONTEXT gate; no authority is granted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "contract_revision",
    "task_id",
    "repository",
    "base_sha",
    "request",
    "source_bindings",
    "repository_context",
    "risk_projection",
    "read_scope_projection",
    "write_scope_projection",
    "upstream_artifacts",
    "context_status",
    "outcome",
    "next_required_action",
    "scope_hash",
    "snapshot_hash",
    "redaction_status",
    "redactions",
    "reason_code",
    "reason_codes",
    "created_at",
    "read_only_projection",
    "write_authority_granted",
    "commit_authority_granted",
    "push_authority_granted",
    "pr_authority_granted",
    "merge_authority_granted",
    "deployment_authority_granted",
    "production_authority_granted"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_type": {
      "const": "intake-card"
    },
    "contract_revision": {
      "const": "intake-context/v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "request": {
      "type": "object",
      "description": "Normalized request intent, outcome, constraints and exclusions."
    },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Canonical source bindings and source mode.",
      "items": {
        "type": "object",
        "required": ["source", "binding"],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "binding": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "repository_context": {
      "type": "object",
      "description": "Repository identity, protected branch and exact protected-base SHA.",
      "required": [
        "repository",
        "protected_branch",
        "protected_base_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "protected_branch": {
          "type": "string",
          "minLength": 1
        },
        "protected_base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "risk_projection": {
      "type": "object",
      "description": "Risk outcome, risk level, flags, required gate, additional authority gates and digest."
    },
    "read_scope_projection": {
      "type": "object",
      "description": "Read-scope outcome, failure classification, include/exclude/missing paths and scope_hash."
    },
    "write_scope_projection": {
      "type": "object",
      "description": "Write-scope outcome, candidate paths, exclusions, prohibited operations, branch-binding status and scope_hash."
    },
    "upstream_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Upstream artifact type/version/digest summary.",
      "items": {
        "type": "object",
        "required": ["artifact_type", "schema_version"],
        "properties": {
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "schema_version": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "context_status": {
      "enum": ["READY", "BLOCKED"]
    },
    "outcome": {
      "enum": ["READY", "BLOCKED"]
    },
    "next_required_action": {
      "enum": ["CONTINUE_CONTEXT_EVALUATION", "ESCALATE_CONTEXT_GAP"]
    },
    "scope_hash": {
      "type": "string",
      "minLength": 1,
      "description": "SHA-256 hex digest of the canonical scope payload."
    },
    "snapshot_hash": {
      "type": "string",
      "minLength": 1,
      "description": "SHA-256 hex digest of the complete redacted card payload."
    },
    "redaction_status": {
      "enum": ["NONE", "APPLIED", "BLOCKED"]
    },
    "redactions": {
      "type": "array",
      "uniqueItems": true,
      "description": "Redaction records; never contains original values.",
      "items": {
        "type": "object",
        "required": ["pointer", "classification", "replacement", "reason_code"],
        "properties": {
          "pointer": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "SECRET",
              "CREDENTIAL",
              "TOKEN",
              "PRIVATE_KEY",
              "PERSONAL_SENSITIVE",
              "POLICY_REDACTED"
            ]
          },
          "replacement": {
            "const": "[REDACTED]"
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string"
    },
    "read_only_projection": {
      "const": true
    },
    "write_authority_granted": {
      "const": false
    },
    "commit_authority_granted": {
      "const": false
    },
    "push_authority_granted": {
      "const": false
    },
    "pr_authority_granted": {
      "const": false
    },
    "merge_authority_granted": {
      "const": false
    },
    "deployment_authority_granted": {
      "const": false
    },
    "production_authority_granted": {
      "const": false
    }
  }
}
