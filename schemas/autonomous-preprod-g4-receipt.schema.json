{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/autonomous-preprod-g4-receipt.schema.json",
  "title": "Autonomous Pre-Prod Standing G4 Decision Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "decision",
    "source",
    "trust_state",
    "policy_id",
    "policy_revision",
    "policy_digest",
    "manifest_digest",
    "parent_approval_id",
    "parent_scope_hash_prefix",
    "parent_authority_digest",
    "run_id",
    "task_id",
    "repository",
    "target_branch",
    "approved_base_ref",
    "approved_base_sha",
    "working_branch",
    "pr_number",
    "approved_head_sha",
    "task_scope_hash",
    "pr_body_digest",
    "managed_block_digest",
    "run_graph_digest",
    "gate_story_digest",
    "evidence_digest",
    "authorized_action",
    "expires_at",
    "decision_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "autonomous-preprod-g4-receipt"},
    "decision": {"const": "ALLOW"},
    "source": {"const": "autonomous_preprod_standing_policy"},
    "trust_state": {"const": "requires_trusted_repo_ci_projection"},
    "policy_id": {"const": "AUTONOMOUS_PREPROD_INTEGRATION_POLICY"},
    "policy_revision": {"type": "string", "minLength": 1},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "parent_approval_id": {"type": "string", "minLength": 1},
    "parent_scope_hash_prefix": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "parent_authority_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "target_branch": {"const": "pre-prod"},
    "approved_base_ref": {"type": "string", "minLength": 1},
    "approved_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "working_branch": {"type": "string", "minLength": 1},
    "pr_number": {"type": "integer", "minimum": 1},
    "approved_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "task_scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pr_body_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "managed_block_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "run_graph_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gate_story_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authorized_action": {"const": "merge_approved_pr"},
    "expires_at": {"type": "string", "format": "date-time"},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}