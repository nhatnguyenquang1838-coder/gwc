{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/execution-throttle-decision.schema.json",
  "title": "Execution Throttle Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "repository",
    "branch",
    "base_sha",
    "head_sha",
    "merge_authority_granted",
    "deployment_authority_granted",
    "production_authority_granted",
    "audit_authority_granted",
    "scale_authority_granted",
    "reason_code",
    "observed_at",
    "decision_digest",
    "batch_id",
    "active_implementation_batch_ids",
    "requested_parallelism",
    "max_parallelism",
    "capacity_units_available",
    "capacity_units_per_worker",
    "available_parallelism",
    "recent_failure_rate",
    "failure_rate_threshold",
    "cooldown_active",
    "previous_batch_terminal",
    "allowed_parallelism",
    "execution_allowed",
    "partial_execution_allowed",
    "outcome"
  ],
  "properties": {
    "artifact_type": {"const": "execution-throttle-decision"},
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "merge_authority_granted": {"const": false},
    "deployment_authority_granted": {"const": false},
    "production_authority_granted": {"const": false},
    "audit_authority_granted": {"const": false},
    "scale_authority_granted": {"const": false},
    "reason_code": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "batch_id": {"type": "string", "minLength": 1},
    "active_implementation_batch_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requested_parallelism": {"type": "integer"},
    "max_parallelism": {"type": "integer"},
    "capacity_units_available": {"type": "integer"},
    "capacity_units_per_worker": {"type": "integer"},
    "available_parallelism": {"type": "integer", "minimum": 0},
    "recent_failure_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "failure_rate_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "cooldown_active": {"type": "boolean"},
    "previous_batch_terminal": {"type": "boolean"},
    "allowed_parallelism": {"type": "integer", "minimum": 0},
    "execution_allowed": {"type": "boolean"},
    "partial_execution_allowed": {"type": "boolean"},
    "outcome": {"enum": ["ALLOW", "THROTTLE", "BLOCKED"]}
  }
}
