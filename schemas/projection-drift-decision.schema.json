{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.dw/schemas/projection-drift-decision.schema.json",
  "title": "Projection Drift Decision",
  "schema_version": "1.0",
  "artifact_type": "projection-drift-decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "repository",
    "projection_target",
    "outcome",
    "authority_status",
    "reason_code",
    "reason_codes",
    "drift_detected",
    "drift_field_count",
    "drift_fields",
    "canonical_state_digest",
    "read_only_projection",
    "write_authority_granted",
    "approval_authority_granted",
    "merge_authority_granted",
    "deployment_authority_granted",
    "production_authority_granted",
    "decision_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "projection-drift-decision"},
    "task_id": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$"},
    "repository": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "projection_target": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_.-]{1,127}$"},
    "outcome": {"enum": ["READY", "BLOCKED"]},
    "authority_status": {"enum": ["CONFIRMED", "REJECTED"]},
    "reason_code": {"type": "string"},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "drift_detected": {"type": "boolean"},
    "drift_field_count": {"type": "integer", "minimum": 0},
    "drift_fields": {"type": "array", "items": {"type": "string"}},
    "canonical_state_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "read_only_projection": {"const": true},
    "write_authority_granted": {"const": false},
    "approval_authority_granted": {"const": false},
    "merge_authority_granted": {"const": false},
    "deployment_authority_granted": {"const": false},
    "production_authority_granted": {"const": false},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
