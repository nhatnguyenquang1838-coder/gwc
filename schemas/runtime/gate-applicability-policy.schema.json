{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/runtime/gate-applicability-policy.schema.json",
  "title": "Gate Applicability Policy",
  "description": "Generic, workflow-agnostic Policy unit. Policy constrains gates; it never defines node ordering and never executes side effects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "default", "required_when", "not_applicable_when", "blocked_when"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "description": {"type": "string"},
    "default": {"enum": ["REQUIRED", "NOT_APPLICABLE", "BLOCKED"]},
    "applies_when": {"$ref": "#/$defs/conditions"},
    "required_when": {"$ref": "#/$defs/conditions"},
    "not_applicable_when": {"$ref": "#/$defs/conditions"},
    "blocked_when": {"$ref": "#/$defs/conditions"},
    "expires_at": {"type": "string", "format": "date-time"},
    "authority_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "authority_type"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "authority_type": {"type": "string", "minLength": 1},
          "allowed_providers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "required_bindings": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "max_age_seconds": {"type": "integer", "minimum": 1},
          "equivalence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "accepts": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "mode": {"enum": ["exact", "equivalent_only_if_declared"]}
            }
          }
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "evidence_type"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "evidence_type": {"type": "string", "minLength": 1},
          "acceptance": {"$ref": "#/$defs/conditions"},
          "mandatory": {"type": "boolean"}
        }
      }
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "action": {"type": "string", "minLength": 1},
          "reason_code": {"type": "string", "minLength": 1}
        }
      }
    },
    "terminal_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicates"],
      "properties": {
        "predicates": {"$ref": "#/$defs/conditions"},
        "mode": {"enum": ["all", "any"]}
      }
    }
  },
  "$defs": {
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "field", "operator"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "field": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "operator": {"enum": ["equals", "in", "exists", "truthy"]},
          "value": {},
          "values": {"type": "array", "minItems": 1}
        },
        "allOf": [
          {"if": {"properties": {"operator": {"const": "equals"}}}, "then": {"required": ["value"]}},
          {"if": {"properties": {"operator": {"const": "in"}}}, "then": {"required": ["values"]}}
        ]
      }
    }
  }
}
