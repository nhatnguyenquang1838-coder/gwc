{
  "$id": "https://gwc.local/schemas/runtime/durable-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GWC Durable Runtime Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "run_id",
    "task_id",
    "repository",
    "gate",
    "runtime_version",
    "node_pack_version",
    "status",
    "current_checkpoint_id",
    "created_at_utc",
    "updated_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "artifact_type": {"const": "durable-run"},
    "run_id": {"type": "string", "pattern": "^run_[a-z0-9][a-z0-9._-]*$"},
    "task_id": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "base_branch", "base_sha"],
      "properties": {
        "full_name": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "base_branch": {"type": "string", "minLength": 1},
        "base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "working_branch": {"type": ["string", "null"]},
        "head_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "gate": {"enum": ["G0_CONTEXT", "G1_ALIGNMENT", "G2_EXECUTION", "G3_PR", "G4_MERGE", "G5_DEPLOY", "G6_PRODUCTION_DATA"]},
    "runtime_version": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
    "node_pack_version": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
    "status": {"enum": ["active", "suspended", "blocked", "completed", "failed", "cancelled", "superseded"]},
    "current_checkpoint_id": {"type": ["string", "null"], "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "updated_at_utc": {"type": "string", "format": "date-time"},
    "metadata": {"type": "object", "additionalProperties": true}
  }
}
