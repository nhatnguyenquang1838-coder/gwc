{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/runtime/runtime-node-extension-registry.schema.json",
  "title": "Post-81 Runtime Node Extension Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "registry_id",
    "revision",
    "baseline_registry_ref",
    "baseline_declared_slot_count",
    "baseline_node_ids_digest",
    "admitted_extension_count",
    "extensions",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "runtime-node-extension-registry"},
    "registry_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "baseline_registry_ref": {"type": "string", "minLength": 1},
    "baseline_declared_slot_count": {"const": 81},
    "baseline_node_ids_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "admitted_extension_count": {"type": "integer", "minimum": 1},
    "extensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["extension_slot", "decision_task_id", "decision_scope_hash", "node", "route"],
        "properties": {
          "extension_slot": {"type": "integer", "minimum": 82},
          "decision_task_id": {"type": "string", "minLength": 1},
          "decision_scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "node": {"$ref": "node-contract.schema.json"},
          "route": {
            "type": "object",
            "additionalProperties": false,
            "required": ["route_id", "nodes", "edges", "terminal_gate", "outcome"],
            "properties": {
              "route_id": {"type": "string", "minLength": 1},
              "nodes": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "edges": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source", "target", "edge_type", "runtime_executable", "provenance"],
                  "properties": {
                    "source": {"type": "string", "minLength": 1},
                    "target": {"type": "string", "minLength": 1},
                    "edge_type": {"enum": ["runtime", "dependency"]},
                    "runtime_executable": {"const": true},
                    "provenance": {"type": "string", "minLength": 1}
                  }
                }
              },
              "terminal_gate": {"const": "G4_MERGE"},
              "outcome": {"const": "HUMAN_REQUIRED"}
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "source_sha"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
