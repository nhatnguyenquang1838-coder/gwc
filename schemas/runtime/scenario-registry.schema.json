{
  "$id": "https://gwc.local/schemas/runtime/scenario-registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "scenario-registry"
    },
    "declared_scenario_count": {
      "minimum": 0,
      "type": "integer"
    },
    "materialized_scenario_count": {
      "const": 14
    },
    "provenance": {
      "minLength": 1,
      "type": "string"
    },
    "registry_id": {
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "type": "string"
    },
    "scenarios": {
      "items": {
        "$ref": "scenario-contract.schema.json"
      },
      "maxItems": 14,
      "minItems": 14,
      "type": "array"
    },
    "schema_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "registry_id",
    "revision",
    "declared_scenario_count",
    "materialized_scenario_count",
    "scenarios",
    "provenance"
  ],
  "title": "Canonical Runtime Scenario Registry",
  "type": "object"
}
