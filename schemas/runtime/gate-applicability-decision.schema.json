{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/runtime/gate-applicability-decision.schema.json",
  "title": "Gate Applicability Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "flow_profile_id", "policy_registry_ref",
    "gate", "policy_ref", "decision", "reason_code", "matched_rule",
    "context_digest", "decision_digest"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "artifact_type": {"const": "gate-applicability-decision"},
    "flow_profile_id": {"type": "string", "minLength": 1},
    "policy_registry_ref": {"type": "string", "minLength": 1},
    "gate": {"enum": ["G0_CONTEXT", "G1_ALIGNMENT", "G2_EXECUTION", "G3_PR", "G4_MERGE", "G5_DEPLOY", "G6_PRODUCTION_DATA"]},
    "policy_ref": {"type": ["string", "null"]},
    "policy_version": {"type": ["string", "null"]},
    "policy_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "policy_registry_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision": {"enum": ["REQUIRED", "NOT_APPLICABLE", "BLOCKED"]},
    "reason_code": {"type": "string", "minLength": 1},
    "matched_rule": {"type": ["string", "null"]},
    "authority_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "authority_type", "satisfied", "reason_code"],
        "properties": {
          "id": {"type": "string"},
          "authority_type": {"type": "string"},
          "satisfied": {"type": "boolean"},
          "reason_code": {"type": "string"}
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "evidence_type", "satisfied", "reason_code"],
        "properties": {
          "id": {"type": "string"},
          "evidence_type": {"type": "string"},
          "satisfied": {"type": "boolean"},
          "reason_code": {"type": "string"}
        }
      }
    },
    "prohibited_actions": {"type": "array", "items": {"type": "string"}},
    "terminal_acceptance": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["accepted", "reason_code"],
      "properties": {
        "accepted": {"type": "boolean"},
        "reason_code": {"type": "string"},
        "unmet": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator", "evaluator_version", "policy_contract_version", "tighten_only"],
      "properties": {
        "evaluator": {"type": "string"},
        "evaluator_version": {"type": "string"},
        "policy_contract_version": {"type": ["string", "null"]},
        "tighten_only": {"type": "boolean"}
      }
    },
    "context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
