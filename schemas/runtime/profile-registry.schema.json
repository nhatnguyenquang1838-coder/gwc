{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/runtime/profile-registry.schema.json",
  "title": "Canonical Runtime Flow Profile Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "registry_id", "revision", "profiles", "provenance"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "artifact_type": {"const": "profile-registry"},
    "registry_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "flow-profile.schema.json"}},
    "provenance": {"type": "string", "minLength": 1}
  }
}
