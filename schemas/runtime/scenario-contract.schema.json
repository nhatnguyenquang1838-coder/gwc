{
  "$id": "https://gwc.local/schemas/runtime/scenario-contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_facts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "artifact_type": {
      "const": "runtime-scenario"
    },
    "category": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "edges": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "edge_type": {
            "enum": [
              "runtime",
              "visualization",
              "suggested_sequence",
              "human_authority",
              "blocked",
              "dependency"
            ]
          },
          "provenance": {
            "minLength": 1,
            "type": "string"
          },
          "runtime_executable": {
            "type": "boolean"
          },
          "source": {
            "minLength": 1,
            "type": "string"
          },
          "target": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source",
          "target",
          "edge_type",
          "runtime_executable",
          "provenance"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "facts_schema": {
      "minLength": 1,
      "type": "string"
    },
    "green_targets": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "guards": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "conditional": {
            "type": "boolean"
          },
          "field": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "enum": [
              "exists",
              "equals",
              "in",
              "gte",
              "lte"
            ]
          },
          "value": {},
          "values": {
            "type": "array"
          }
        },
        "required": [
          "id",
          "type",
          "field",
          "conditional",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "human_boundaries": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "source_path": {
          "minLength": 1,
          "type": "string"
        },
        "source_sha": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "source_status": {
          "enum": [
            "canonical_explicit",
            "declared_scenario_space"
          ]
        }
      },
      "required": [
        "source_path",
        "source_sha",
        "source_status"
      ],
      "type": "object"
    },
    "route_nodes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "route_policy": {
      "additionalProperties": false,
      "properties": {
        "allowed_authorities": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "green_targets": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "max_depth": {
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "start_node": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "start_node",
        "green_targets",
        "allowed_authorities",
        "max_depth"
      ],
      "type": "object"
    },
    "rules": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "id",
    "version",
    "category",
    "activation_facts",
    "facts_schema",
    "rules",
    "guards",
    "route_nodes",
    "route_policy",
    "edges",
    "green_targets",
    "human_boundaries",
    "evidence_refs",
    "provenance"
  ],
  "title": "Canonical Runtime Scenario Contract",
  "type": "object"
}
