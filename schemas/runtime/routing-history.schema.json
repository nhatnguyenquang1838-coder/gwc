{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/runtime/routing-history.schema.json",
  "title": "Canonical Runtime Routing History",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "run_id", "graph_revision", "observed_facts", "candidate_routes", "evidence_refs", "provenance"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "artifact_type": {"const": "routing-history"},
    "run_id": {"type": "string", "minLength": 1},
    "graph_revision": {"type": "string", "minLength": 1},
    "observed_facts": {"type": "object"},
    "candidate_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "classification", "node_ids", "reason"],
        "properties": {
          "route_id": {"type": "string", "minLength": 1},
          "classification": {"enum": ["VALID_AUTO", "CONDITIONAL", "BLOCKED", "HUMAN_REQUIRED"]},
          "node_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "selected_route": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "source_sha"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "source_sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
