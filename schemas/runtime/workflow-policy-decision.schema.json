{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dw-super.local/schemas/runtime/workflow-policy-decision.schema.json",
  "title": "Workflow Policy Runtime Decision",
  "description": "Deterministic proof produced by compiling Workflow composition with Policy constraints and exact runtime context. This artifact is not mutable execution state and grants no authority by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "workflow", "policy",
    "current_node", "current_gate", "applicability", "outcome",
    "next_nodes", "next_gate", "terminal_disposition",
    "authority_requirements", "evidence_requirements", "prohibited_actions",
    "terminal_acceptance", "reason_codes", "context_digest",
    "compatibility_digest", "applicability_decision_digest", "decision_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "workflow-policy-runtime-decision"},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "profile_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "revision", "registry_digest", "policy_ref", "policy_version", "policy_digest"],
      "properties": {
        "registry_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "policy_ref": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "current_node": {"type": "string", "minLength": 1},
    "current_gate": {
      "enum": ["G0_CONTEXT", "G1_ALIGNMENT", "G2_EXECUTION", "G3_PR", "G4_MERGE", "G5_DEPLOY", "G6_PRODUCTION_DATA"]
    },
    "applicability": {"enum": ["REQUIRED", "NOT_APPLICABLE", "BLOCKED"]},
    "outcome": {"enum": ["CONTINUE", "TERMINAL", "BLOCKED", "HUMAN_REQUIRED"]},
    "next_nodes": {
      "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    },
    "next_gate": {
      "type": ["string", "null"],
      "enum": [null, "G0_CONTEXT", "G1_ALIGNMENT", "G2_EXECUTION", "G3_PR", "G4_MERGE", "G5_DEPLOY", "G6_PRODUCTION_DATA"]
    },
    "terminal_disposition": {"type": ["string", "null"]},
    "authority_requirements": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "authority_type", "satisfied", "reason_code"],
        "properties": {
          "id": {"type": "string"}, "authority_type": {"type": "string"},
          "satisfied": {"type": "boolean"}, "reason_code": {"type": "string"}
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "evidence_type", "satisfied", "reason_code"],
        "properties": {
          "id": {"type": "string"}, "evidence_type": {"type": "string"},
          "satisfied": {"type": "boolean"}, "reason_code": {"type": "string"}
        }
      }
    },
    "prohibited_actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "terminal_acceptance": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["accepted", "reason_code"],
      "properties": {
        "accepted": {"type": "boolean"},
        "reason_code": {"type": "string"},
        "unmet": {"type": "array", "items": {"type": "string"}}
      }
    },
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "compatibility_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "applicability_decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "CONTINUE"}}, "required": ["outcome"]},
      "then": {
        "anyOf": [
          {"properties": {"next_nodes": {"minItems": 1}}},
          {"properties": {"next_gate": {"type": "string"}}}
        ]
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "TERMINAL"}}, "required": ["outcome"]},
      "then": {"properties": {"terminal_disposition": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "HUMAN_REQUIRED"}}, "required": ["outcome"]},
      "then": {"properties": {"terminal_disposition": {"const": "HUMAN_REQUIRED"}}}
    },
    {
      "if": {"properties": {"applicability": {"const": "BLOCKED"}}, "required": ["applicability"]},
      "then": {"properties": {"outcome": {"const": "BLOCKED"}}}
    }
  ]
}
