{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dw-super.local/schemas/runtime/flow-policy-runtime-profile.schema.json",
  "title": "Flow Policy Runtime Activation Profile",
  "description": "Pins one validated Workflow and Policy pair to the runtime adapter. This is static activation configuration, not live execution state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "profile_id", "revision", "status", "workflow", "policy", "route_profile", "runtime"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "flow-policy-runtime-profile"},
    "profile_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "inactive"]},
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "revision", "workflow_digest"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "workflow_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["registry_id", "revision", "registry_digest"],
      "properties": {
        "registry_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "route_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "revision"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_ref", "decision_schema_ref", "compatibility_validator_ref"],
      "properties": {
        "adapter_ref": {"type": "string", "pattern": "^[^:]+:[A-Za-z_][A-Za-z0-9_]*$"},
        "decision_schema_ref": {"type": "string", "minLength": 1},
        "compatibility_validator_ref": {"type": "string", "pattern": "^[^:]+:[A-Za-z_][A-Za-z0-9_]*$"}
      }
    }
  }
}
