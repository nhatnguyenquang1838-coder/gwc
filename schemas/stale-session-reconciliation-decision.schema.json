{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/stale-session-reconciliation-decision.schema.json",
  "title": "GWC Stale Session Reconciliation Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "task_id", "repository", "branch", "base_sha", "head_sha", "scope_hash", "session_id", "observed_owner", "canonical_owner", "observed_checkpoint_rev", "canonical_checkpoint_rev", "lease_status", "working_tree_status", "pending_action_status", "observed_at", "stale_owner", "stale_checkpoint", "outcome", "reason_code", "advance_allowed", "checkpoint_required", "decision_digest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "stale-session-reconciliation-decision"},
    "task_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "branch": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "session_id": {"type": "string", "minLength": 1},
    "observed_owner": {"type": "string", "minLength": 1},
    "canonical_owner": {"type": "string", "minLength": 1},
    "observed_checkpoint_rev": {"type": "integer", "minimum": 0},
    "canonical_checkpoint_rev": {"type": "integer", "minimum": 0},
    "lease_status": {"enum": ["ACTIVE", "EXPIRED", "MISSING"]},
    "working_tree_status": {"enum": ["CLEAN", "DIRTY", "UNKNOWN"]},
    "pending_action_status": {"enum": ["NONE", "PENDING", "UNKNOWN", "COMMITTED"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "stale_owner": {"type": "boolean"},
    "stale_checkpoint": {"type": "boolean"},
    "outcome": {"enum": ["CONTINUE", "SUPERSEDE", "RECONCILE", "HUMAN_REQUIRED"]},
    "reason_code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "advance_allowed": {"type": "boolean"},
    "checkpoint_required": {"type": "boolean"},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
