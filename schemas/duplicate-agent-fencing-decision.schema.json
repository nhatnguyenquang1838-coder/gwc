{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/duplicate-agent-fencing-decision.schema.json",
  "title": "Duplicate Agent Fencing Decision",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "repository",
    "branch",
    "base_sha",
    "head_sha",
    "scope_hash",
    "run_id",
    "worker_id",
    "active_lease_holder",
    "worker_fencing_token",
    "observed_fencing_token",
    "lease_state",
    "side_effect_key",
    "stale_worker",
    "duplicate_effect",
    "fencing_enforced",
    "advancement_allowed",
    "side_effect_allowed",
    "duplicate_effect_prevented",
    "outcome",
    "reason_code",
    "observed_at",
    "decision_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "duplicate-agent-fencing-decision"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fencing_enforced": {"const": true},
    "lease_state": {"enum": ["ACTIVE", "EXPIRED", "REVOKED", "UNKNOWN"]},
    "outcome": {"enum": ["ALLOW_SINGLE_EFFECT", "BLOCK_NO_ACTIVE_LEASE", "FENCE_STALE_WORKER", "FENCE_DUPLICATE_AGENT", "SUPPRESS_DUPLICATE_EFFECT"]},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
