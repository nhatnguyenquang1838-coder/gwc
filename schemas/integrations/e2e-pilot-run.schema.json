{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DW SUPER E2E Pilot Run",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "pilot_id",
    "g6",
    "nodes",
    "side_effects",
    "replay",
    "projections"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "task_id": {
      "const": "SCRUM-121"
    },
    "pilot_id": {
      "const": "PILOT-121-A"
    },
    "g6": {
      "type": "object",
      "required": [
        "applicable"
      ],
      "properties": {
        "applicable": {
          "const": false
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1
    },
    "side_effects": {
      "type": "array"
    },
    "replay": {
      "type": "object"
    },
    "projections": {
      "type": "array"
    }
  }
}