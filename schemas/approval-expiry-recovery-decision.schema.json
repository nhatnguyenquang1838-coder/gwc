{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/approval-expiry-recovery-decision.schema.json",
  "title": "Approval Expiry Recovery Decision",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "repository",
    "branch",
    "base_sha",
    "head_sha",
    "approval_id",
    "approval_scope_hash",
    "current_scope_hash",
    "approval_expires_at",
    "now_at",
    "approval_expired",
    "scope_drifted",
    "continuation_requested",
    "checkpoint_required",
    "replay_detected",
    "replay_rejected",
    "regenerate_approval_required",
    "wait_allowed",
    "continuation_allowed",
    "stale_continuation_allowed",
    "outcome",
    "reason_code",
    "observed_at",
    "decision_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "approval-expiry-recovery-decision"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "approval_scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "current_scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stale_continuation_allowed": {"const": false},
    "outcome": {"enum": ["CONTINUE", "CHECKPOINT_BEFORE_WAIT", "REGENERATE_APPROVAL", "REJECT_REPLAY"]},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
