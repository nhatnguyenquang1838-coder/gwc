{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.dw/schemas/external-audit-event-projection.schema.json",
  "title": "external-audit-event-projection",
  "schema_version": "1.0",
  "artifact_type": "external-audit-event-projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "repository",
    "projection_target",
    "source_authority_digest",
    "evidence_linkset_digest",
    "privacy_boundary_digest",
    "canonical_state",
    "canonical_state_digest",
    "prior_projection_present",
    "read_only_projection",
    "write_authority_granted",
    "approval_authority_granted",
    "merge_authority_granted",
    "deployment_authority_granted",
    "production_authority_granted",
    "projected_at",
    "outcome",
    "reason_code",
    "reason_codes",
    "projection_digest"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "artifact_type": { "type": "string", "const": "external-audit-event-projection" },
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "projection_target": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$" },
    "source_authority_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "evidence_linkset_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "privacy_boundary_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "canonical_state": { "type": "object" },
    "canonical_state_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "prior_projection_present": { "type": "boolean" },
    "read_only_projection": { "type": "boolean", "const": true },
    "write_authority_granted": { "type": "boolean", "const": false },
    "approval_authority_granted": { "type": "boolean", "const": false },
    "merge_authority_granted": { "type": "boolean", "const": false },
    "deployment_authority_granted": { "type": "boolean", "const": false },
    "production_authority_granted": { "type": "boolean", "const": false },
    "projected_at": { "type": "string" },
    "outcome": { "type": "string", "enum": ["READY", "BLOCKED"] },
    "reason_code": { "type": "string" },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "projection_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
