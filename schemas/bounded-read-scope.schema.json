{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/bounded-read-scope.schema.json",
  "title": "Bounded Read Scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "node_id",
    "task_id",
    "repository",
    "base_sha",
    "branch",
    "gate",
    "authority_boundary",
    "files_read",
    "constraints",
    "exclusions",
    "entry_guards",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_type": {
      "const": "bounded-read-scope"
    },
    "node_id": {
      "const": "intake_context.files-read-scope"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "gate": {
      "const": "G0_CONTEXT"
    },
    "authority_boundary": {
      "const": "read_only"
    },
    "files_read": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)(?!.*:).+$"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entry_guards": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason_codes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ACCEPTED",
        "MISSING_EVIDENCE",
        "MALFORMED_INPUT",
        "SCOPE_DRIFT"
      ],
      "properties": {
        "ACCEPTED": {
          "type": "string",
          "minLength": 1
        },
        "MISSING_EVIDENCE": {
          "type": "string",
          "minLength": 1
        },
        "MALFORMED_INPUT": {
          "type": "string",
          "minLength": 1
        },
        "SCOPE_DRIFT": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
