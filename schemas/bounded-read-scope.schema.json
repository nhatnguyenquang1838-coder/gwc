{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/bounded-read-scope.schema.json",
  "title": "Bounded Read Scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "contract_revision",
    "node_id",
    "task_id",
    "repository",
    "base_sha",
    "branch",
    "gate",
    "authority_boundary",
    "source_bindings",
    "outcome",
    "failure_classification",
    "files_read",
    "files_exclude",
    "files_missing",
    "exclusion_reasons",
    "constraints",
    "exclusions",
    "entry_guards",
    "reason_code",
    "reason_codes",
    "next_route",
    "observed_at",
    "scope_hash",
    "read_only_projection",
    "write_authority_granted",
    "commit_authority_granted",
    "push_authority_granted",
    "pr_authority_granted",
    "merge_authority_granted",
    "deployment_authority_granted",
    "production_authority_granted"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "bounded-read-scope"},
    "contract_revision": {"const": "files-read-scope/v2"},
    "node_id": {"const": "intake_context.files-read-scope"},
    "task_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string", "minLength": 1},
    "gate": {"const": "G0_CONTEXT"},
    "authority_boundary": {"const": "read_only"},
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "ref", "revision", "status"],
        "properties": {
          "source_type": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1},
          "status": {"enum": ["VERIFIED", "STALE", "MISSING", "AMBIGUOUS", "CONFLICT"]}
        }
      }
    },
    "outcome": {"enum": ["READY", "BLOCKED"]},
    "failure_classification": {
      "type": ["string", "null"],
      "enum": [null, "AGENT_PREPARATION_BLOCKED", "REPOSITORY_EVIDENCE_MISSING", "VALIDATION_FAILED"]
    },
    "files_read": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:).+$"}
    },
    "files_exclude": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:).+$"}
    },
    "files_missing": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:).+$"}
    },
    "exclusion_reasons": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "constraints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "exclusions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "entry_guards": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reason_code": {"enum": ["ACCEPTED", "MISSING_EVIDENCE", "MALFORMED_INPUT", "SCOPE_DRIFT"]},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["ACCEPTED", "MISSING_EVIDENCE", "MALFORMED_INPUT", "SCOPE_DRIFT"]}
    },
    "next_route": {"enum": ["READY_FOR_INTAKE_CARD", "RECOMPUTE_READ_SCOPE", "CLARIFY_READ_SCOPE", "REFRESH_REPOSITORY_EVIDENCE"]},
    "observed_at": {"type": ["string", "null"]},
    "scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "read_only_projection": {"const": true},
    "write_authority_granted": {"const": false},
    "commit_authority_granted": {"const": false},
    "push_authority_granted": {"const": false},
    "pr_authority_granted": {"const": false},
    "merge_authority_granted": {"const": false},
    "deployment_authority_granted": {"const": false},
    "production_authority_granted": {"const": false}
  }
}
