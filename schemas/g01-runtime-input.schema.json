{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/g01-runtime-input.schema.json",
  "title": "G01 Runtime Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "generated_at",
    "project",
    "repository",
    "runtime",
    "task",
    "request",
    "policies",
    "sources",
    "risk"
  ],
  "$defs": {
    "riskItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "impact",
        "mitigation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RISK-[0-9]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "mitigation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "verifiable"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-[0-9]+$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "verifiable": {
          "type": "boolean"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "ref",
        "source_sha"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "required",
        "status",
        "source_sha"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "MISSING",
            "UNVERIFIED"
          ]
        },
        "source_sha": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "implementationPlanObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "reason",
        "source",
        "task_me_applicable",
        "task_me_available",
        "task_me_invoked",
        "task_me_fallback_reason",
        "canonical_task_uid",
        "repository",
        "protected_base_sha",
        "plan_root",
        "requirements_path",
        "design_path",
        "tasks_path",
        "plan_revision",
        "validation_status",
        "validation_evidence",
        "generated_by",
        "generated_at_utc"
      ],
      "properties": {
        "applicability": {
          "enum": [
            "required",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "existing_kiro",
            "task_me",
            "generated_kiro",
            "plan_not_applicable"
          ]
        },
        "task_me_applicable": {
          "type": "boolean"
        },
        "task_me_available": {
          "type": "boolean"
        },
        "task_me_invoked": {
          "type": "boolean"
        },
        "task_me_fallback_reason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "canonical_task_uid": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "protected_base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "plan_root": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "requirements_path": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "design_path": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "tasks_path": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_revision": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(sha256:)?[0-9a-f]{40,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        },
        "validation_evidence": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "generated_by": {
          "type": "string",
          "minLength": 1
        },
        "generated_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "required"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "enum": [
                  "existing_kiro",
                  "task_me",
                  "generated_kiro"
                ]
              },
              "plan_root": {
                "type": "string",
                "minLength": 1
              },
              "requirements_path": {
                "type": "string",
                "minLength": 1
              },
              "design_path": {
                "type": "string",
                "minLength": 1
              },
              "tasks_path": {
                "type": "string",
                "minLength": 1
              },
              "plan_revision": {
                "type": "string",
                "pattern": "^(sha256:)?[0-9a-f]{40,64}$"
              },
              "validation_status": {
                "const": "PASS"
              },
              "validation_evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "const": "plan_not_applicable"
              },
              "validation_status": {
                "const": "NOT_APPLICABLE"
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_type": {
      "const": "g01-runtime-input"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "profile_path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "profile_path": {
          "type": "string",
          "pattern": "^projects/[^/]+/project-profile\\.yaml$"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name",
        "base_ref",
        "base_sha",
        "protected_branches",
        "connector",
        "write_enabled",
        "verified"
      ],
      "properties": {
        "full_name": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "base_ref": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "protected_branches": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "connector": {
          "type": "string",
          "minLength": 1
        },
        "write_enabled": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean"
        },
        "source_baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "provider",
            "observed_ref",
            "observed_sha",
            "observed_at_utc",
            "local_state"
          ],
          "properties": {
            "authority": {
              "enum": [
                "REMOTE_PROTECTED_BASE",
                "EXPLICIT_TASK_REF"
              ]
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "observed_ref": {
              "type": "string",
              "minLength": 1
            },
            "observed_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "observed_at_utc": {
              "type": "string",
              "format": "date-time"
            },
            "local_state": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "head_sha",
                "dirty",
                "equivalence",
                "analysis_eligible"
              ],
              "properties": {
                "ref": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "head_sha": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "dirty": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "equivalence": {
                  "enum": [
                    "MATCH",
                    "MISMATCH",
                    "UNVERIFIED",
                    "NOT_APPLICABLE"
                  ]
                },
                "analysis_eligible": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_runtime_id",
        "execution_mode",
        "selected_profile",
        "connector_priority",
        "selected_connector",
        "connector_fallback_evidence",
        "required_behavior_contracts"
      ],
      "properties": {
        "agent_runtime_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "execution_mode": {
          "enum": [
            "chat_connector_only",
            "local_agent",
            "repo_ci"
          ]
        },
        "selected_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "path",
            "status",
            "source_sha",
            "supported_execution_modes"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,63}$"
            },
            "path": {
              "type": "string",
              "pattern": "^governance/agent-runtime-profiles/[^/]+\\.ya?ml$"
            },
            "status": {
              "const": "active"
            },
            "source_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            },
            "supported_execution_modes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "chat_connector_only",
                  "local_agent",
                  "repo_ci"
                ]
              }
            }
          }
        },
        "connector_priority": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected_connector": {
          "type": "string",
          "minLength": 1
        },
        "connector_fallback_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "connector",
              "role",
              "status",
              "evidence"
            ],
            "properties": {
              "connector": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "primary",
                  "fallback"
                ]
              },
              "status": {
                "enum": [
                  "AVAILABLE",
                  "UNAVAILABLE",
                  "SKIPPED"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "required_behavior_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claimed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claimed": {
          "type": "boolean"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requester",
        "problem",
        "desired_outcome",
        "affected",
        "in_scope",
        "non_goals",
        "constraints",
        "assumptions",
        "risks",
        "acceptance_criteria",
        "unresolved_questions"
      ],
      "properties": {
        "requester": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statement",
            "why_now"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "why_now": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "desired_outcome": {
          "type": "string",
          "minLength": 1
        },
        "affected": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "in_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_goals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/riskItem"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptance"
          }
        },
        "unresolved_questions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/policy"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "human_direction_confirmed"
      ],
      "properties": {
        "class": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3"
          ]
        },
        "human_direction_confirmed": {
          "type": "boolean"
        }
      }
    },
    "implementation_plan_observation": {
      "$ref": "#/$defs/implementationPlanObservation"
    }
  }
}
