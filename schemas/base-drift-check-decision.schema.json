{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/base-drift-check-decision.schema.json",
  "title": "BaseDriftDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["node_id", "outcome", "reason_codes", "repository", "approved_base_sha", "observed_base_sha", "scope_hash", "invalidates_approval", "requires_reapproval", "may_continue", "pending_action", "decision_digest", "merge_authority_granted", "deployment_authority_granted", "production_authority_granted"],
  "properties": {
    "node_id": {"const": "repo_delivery.base-drift-check"},
    "outcome": {"enum": ["BASE_CURRENT", "BASE_DRIFT_REAPPROVAL_REQUIRED", "BASE_OBSERVABILITY_BLOCKED", "RECONCILE_PENDING_ACTION_FIRST", "INVALID_INPUT"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "repository": {"type": "string"},
    "approved_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$|^$"},
    "observed_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$|^$"},
    "scope_hash": {"type": "string"},
    "invalidates_approval": {"type": "boolean"},
    "requires_reapproval": {"type": "boolean"},
    "may_continue": {"type": "boolean"},
    "pending_action": {"type": ["string", "null"]},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "merge_authority_granted": {"const": false},
    "deployment_authority_granted": {"const": false},
    "production_authority_granted": {"const": false}
  }
}
