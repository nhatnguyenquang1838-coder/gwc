{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/autonomous-preprod-run-manifest.schema.json",
  "title": "Autonomous Pre-Prod Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "run_id",
    "repository",
    "policy_id",
    "policy_revision",
    "policy_digest",
    "approved_base_ref",
    "approved_base_sha",
    "target_branch",
    "allowed_tasks",
    "issued_at",
    "expires_at",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "autonomous-preprod-run-manifest"},
    "run_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_revision": {"type": "string", "minLength": 1},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "approved_base_ref": {"type": "string", "minLength": 1},
    "approved_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_branch": {"const": "pre-prod"},
    "allowed_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "risk_class",
          "working_branch",
          "authorized_paths",
          "authorized_g2_actions",
          "scope_hash"
        ],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "risk_class": {"enum": ["R0", "R1", "R2", "R3"]},
          "working_branch": {"type": "string", "minLength": 1},
          "authorized_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "authorized_g2_actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "minLength": 1}
  }
}
