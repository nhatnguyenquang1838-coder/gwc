{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwc.local/schemas/autonomous-preprod-run-manifest.schema.json",
  "title": "Autonomous Pre-Prod Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "run_id",
    "repository",
    "policy_id",
    "policy_revision",
    "policy_digest",
    "approved_base_ref",
    "approved_base_sha",
    "target_branch",
    "allowed_tasks",
    "issued_at",
    "expires_at",
    "idempotency_key",
    "authority_receipt"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "autonomous-preprod-run-manifest"},
    "run_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "policy_id": {"const": "AUTONOMOUS_PREPROD_INTEGRATION_POLICY"},
    "policy_revision": {"type": "string", "minLength": 1},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "approved_base_ref": {"type": "string", "minLength": 1},
    "approved_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_branch": {"const": "pre-prod"},
    "immutable_authority_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "risk_class",
          "working_branch",
          "authorized_paths",
          "authorized_g2_actions",
          "scope_hash"
        ],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "risk_class": {"enum": ["R0", "R1", "R2", "R3"]},
          "working_branch": {"type": "string", "minLength": 1},
          "authorized_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "authorized_g2_actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "authority_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source",
        "bot_login",
        "marker",
        "approval_id",
        "receipt_comment_id",
        "source_comment_id",
        "approved_run_id",
        "approved_policy_id",
        "approved_policy_revision",
        "approved_policy_digest",
        "manifest_scope_digest",
        "scope_hash_prefix",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "status": {"const": "present"},
        "source": {"const": "github_actions_bot_comment"},
        "bot_login": {"const": "github-actions[bot]"},
        "marker": {"const": "gwc:autonomous-preprod-run-authority-receipt"},
        "approval_id": {"type": "string", "minLength": 1},
        "receipt_comment_id": {"type": "integer", "minimum": 1},
        "source_comment_id": {"type": "integer", "minimum": 1},
        "approved_run_id": {"type": "string", "minLength": 1},
        "approved_policy_id": {"const": "AUTONOMOUS_PREPROD_INTEGRATION_POLICY"},
        "approved_policy_revision": {"type": "string", "minLength": 1},
        "approved_policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "manifest_scope_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "scope_hash_prefix": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "approved_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "materialized_preprod_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
